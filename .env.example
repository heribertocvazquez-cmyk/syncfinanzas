# SyncFinanzas — Variables de entorno.
# Copie este archivo a ".env" SOLO para pruebas locales. En Vercel las
# variables se configuran en el panel (Project > Settings > Environment
# Variables). NUNCA suba valores reales a GitHub ni los comparta en chat.
#
# Dónde se consigue cada valor: ver README.md, pasos 2 y 3.

# Supabase (proyecto gratuito). La URL y la clave anónima van también al
# navegador; la service_role SOLO al servidor (Vercel), nunca al cliente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Las mismas dos primeras, con prefijo VITE_, para el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cadena del pooler de Postgres de Supabase (puerto 6543, modo transacción).
# Formato: postgresql://postgres.USUARIO:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Se consigue en Supabase: Settings > Database > Connection string > Transaction pooler.
DATABASE_URL=

# OPCIONAL. Solo para la lectura automática de comprobantes (visión por IA).
# Sin esta clave, la lectura automática muestra un aviso y la aplicación sigue
# funcionando con la foto como comprobante y registro manual.
OPENAI_API_KEY=

# OPCIONAL (recomendado). Envío automático de invitaciones por correo con
# Resend (plan gratuito: 100 correos al día). Sin esta clave, las
# invitaciones se crean igual, pero el correo no se envía: la aplicación
# muestra el enlace de invitación para copiarlo como respaldo.
# Se consigue en resend.com > API Keys. El remitente por defecto es
# onboarding@resend.dev; con dominio propio verificado, configure
# RESEND_FROM, por ejemplo: SyncFinanzas <invitaciones@sudominio.com>
RESEND_API_KEY=
RESEND_FROM=

# OPCIONAL. URL pública de la aplicación, base de los enlaces de invitación
# (https://<app>.vercel.app/invite?token=...). Si no se configura, se toma
# del dominio de Vercel o del origen de la petición.
APP_URL=
